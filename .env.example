# Copy this file to .env.<NODE_ENV> (e.g. .env.development, .env.production)
# and fill in real values. Never commit the filled-in file.

NODE_ENV=development

# Server
PORT=3000

# Database dialect: postgres | mysql
DIALECT=postgres

# PostgreSQL (required when DIALECT=postgres, the default)
POSTGRES=localhost
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_DATABASE=express-boilerplate

# MySQL (required when DIALECT=mysql)
MYSQL=localhost
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=3306
MYSQL_DATABASE=express-boilerplate

# MongoDB (optional — lib/mongo.js is not wired into app.js by default)
MONGO=mongodb://localhost:27017/express-boilerplate

# Session (required)
SESSION_SECRET=

# JWT (required)
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=2h

# Mail (optional)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=user@example.com
MAIL_PASSWORD=
TEMPLATE_ENGINE=handlebars

# Redis (optional — lib/redis.js is not wired into app.js by default)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ (optional — lib/rabbitmq.js is not wired into app.js by default)
RABBITMQ_HOST=localhost
QUEUE=testqueue

# OAuth (optional — Google/Facebook passport strategies are not wired into
# app.js by default)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/auth/google/cb
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/cb
